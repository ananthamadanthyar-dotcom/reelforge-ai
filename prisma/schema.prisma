generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MASTER_ADMIN
}

enum Plan {
  FREE
  CREATOR
  PRO
  BUSINESS
}

model User {
  id               String       @id @default(cuid())
  name             String?
  email            String?      @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  
  role             Role         @default(USER)
  plan             Plan         @default(FREE)
  stripeCustomerId String?      @unique
  
  premiumOverride  Boolean      @default(false)
  premiumExpiresAt DateTime?

  accounts         Account[]
  sessions         Session[]
  entitlements     Entitlement[]
  creditBalance    CreditBalance?
  projects         Project[]
  series           Series[]     // Added relation to user series

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      @default(100)
  updatedAt DateTime @updatedAt
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  isEnabled Boolean  @default(true)
  expiresAt DateTime?
  
  @@unique([userId, feature])
}

// --- MERGED PROJECT MODEL ---
model Project {
  id               String   @id @default(cuid())
  
  // Database Relations
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status           String   @default("DRAFT")

  // Step 8: Series Details
  seriesName       String
  postingFrequency String?
  postingTime      String?

  // Step 1 & 2: Niche and Voice
  niche            String?
  language         String?
  voice            String?
  
  // Step 3 & 4: Music and Art
  artStyle         String?
  musicTracks      String?  
  
  // Step 5 & 6: Captions and Effects
  captionStyle     String?
  glitchEffect     Boolean  @default(false)
  animatedHook     Boolean  @default(false)
  
  // Step 7: Socials & Watermark
  youtubeEnabled   Boolean  @default(true)
  instagramEnabled Boolean  @default(true)
  tiktokEnabled    Boolean  @default(true)
  watermarkText    String?
  watermarkImage   String?  
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --- SERIES MODEL LINKED TO USER ---
model Series {
  id          String   @id @default(cuid())
  name        String
  niche       String
  frequency   String
  status      String   @default("Active")
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Auth.js Required Tables ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}